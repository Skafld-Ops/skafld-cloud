# =============================================================================
# Skafld Cloud — Environment Variables
# =============================================================================
# Copy to .env for local development, or manage via Doppler for all environments.
# In Railway, these are set via the dashboard or synced from Doppler.
#
# Doppler environments:
#   dev       → local development
#   stg       → staging / preview deploys
#   prd       → production (cloud.skafldstudio.com)
# =============================================================================

# --- Nextcloud Admin (only used on first boot) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# --- Nextcloud Instance ---
NEXTCLOUD_TRUSTED_DOMAINS=cloud.skafldstudio.com
NEXTCLOUD_DATA_DIR=/var/www/html/data

# --- PostgreSQL (Railway auto-provisions these) ---
POSTGRES_HOST=
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Redis (Railway auto-provisions REDIS_URL) ---
# Our redis-config.php parses REDIS_URL into host/port/password automatically.
# The REDIS_HOST vars are used by the Nextcloud Docker entrypoint for first-boot config.
REDIS_URL=
REDIS_HOST=
REDIS_HOST_PORT=6379
REDIS_HOST_PASSWORD=

# --- SMTP (Resend) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTHTYPE=LOGIN
SMTP_NAME=resend
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=notifications
MAIL_DOMAIN=skafldstudio.com

# --- Railway-specific ---
RAILWAY_RUN_UID=0
PORT=80
