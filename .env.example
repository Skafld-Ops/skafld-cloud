# =============================================================================
# Skafld Cloud — Environment Variables
# =============================================================================
# Managed via Doppler (doppler.yaml). Do NOT commit real values.
#
# Doppler environments:
#   dev       → local development (Mailhog, local Postgres/Redis)
#   stg       → staging (staging-cloud.skafldstudio.com)
#   prd       → production (cloud.skafldstudio.com)
#
# Local usage:   doppler run -- docker compose up
# Railway:       synced from Doppler prd config, or set directly in dashboard
# =============================================================================

# --- Nextcloud Admin (first boot only) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_TRUSTED_DOMAINS=cloud.skafldstudio.com
NEXTCLOUD_UPDATE=1

# --- Nextcloud Reverse Proxy ---
OVERWRITEHOST=cloud.skafldstudio.com
OVERWRITEPROTOCOL=https

# --- PostgreSQL ---
POSTGRES_HOST=postgres.railway.internal
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Redis (parsed by docker/redis-config.php) ---
REDIS_URL=redis://default:password@redis.railway.internal:6379

# --- S3 Object Storage (Railway Buckets) ---
OBJECTSTORE_S3_BUCKET=
OBJECTSTORE_S3_HOST=storage.railway.app
OBJECTSTORE_S3_KEY=
OBJECTSTORE_S3_SECRET=
OBJECTSTORE_S3_PORT=443
OBJECTSTORE_S3_REGION=sjc
OBJECTSTORE_S3_SSL=true

# --- SMTP (Resend) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTHTYPE=LOGIN
SMTP_NAME=resend
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply
MAIL_DOMAIN=notifications.skafldstudio.com
